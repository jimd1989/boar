((author "Jim Dalrymple")
 (synopsis "creating random audio signals")
 (license "BSD")
 (dependencies srfi-4 typed-records)
 (components 
   (extension boar-noise
    (csc-options "-O3" "-strict-types"
                 "-C" "-O3" "-C" "-ffast-math" "-C" "-march=native")
    (link-options "noise.c"))))
