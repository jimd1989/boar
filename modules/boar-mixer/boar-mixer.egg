((author "Jim Dalrymple")
 (synopsis "folds and maps over numerical vectors")
 (synopsis "mix floating point streams to raw bytes")
 (license "BSD")
 (dependencies boar-slice srfi-4 typed-records)
 (components 
   (extension boar-mixer
    (csc-options "-O3" "-strict-types")
    (link-options "mixer.c"))))
