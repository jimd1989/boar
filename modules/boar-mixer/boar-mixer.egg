((author "Jim Dalrymple")
 (synopsis "mix floating point streams to raw bytes")
 (license "BSD")
 (dependencies boar-param boar-slice srfi-4 typed-records)
 (components 
   (extension boar-mixer
    (csc-options "-O3" "-strict-types" "-Llm"
                 "-C" "-O3" "-C" "-ffast-math" "-C" "-march=native")
    (link-options "mixer.c"))))
