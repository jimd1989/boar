(module matrix-1000 (note-on note-off)
  (import scheme (chicken base) (chicken bitwise) (chicken string) 
          (chicken type) srfi-4)

  (: note-on (fixnum fixnum -> (u8vector any -> fixnum)))
  (define (note-on ch n)
    (lambda (u8 x)
      (u8vector-set! u8 0 (+ ch 144 -1))
      (u8vector-set! u8 1 n)
      (u8vector-set! u8 2 127)
      3))

  (: note-off (fixnum fixnum -> (u8vector any -> fixnum)))
  (define (note-off ch n)
    (lambda (u8 x)
      (u8vector-set! u8 0 (+ ch 144 -1))
      (u8vector-set! u8 1 n)
      (u8vector-set! u8 2 0)
      3))
  
  (: nrpn (fixnum fixnum fixnum -> (u8vector any -> fixnum)))
  (define (nrpn ch param n)
    (lambda (u8 x)
      (let ((cc (+ 176 (- ch 1))))
        (u8vector-set! u8 0 cc)
        (u8vector-set! u8 1 99)
        (u8vector-set! u8 2 0)
        (u8vector-set! u8 3 cc)
        (u8vector-set! u8 4 98)
        (u8vector-set! u8 5 param)
        (u8vector-set! u8 6 cc)
        (u8vector-set! u8 7 6)
        (u8vector-set! u8 8 n)
        (u8vector-set! u8 9 cc)
        (u8vector-set! u8 10 38)
        (u8vector-set! u8 11 0)
        12)))

  (define-syntax matrix-cmd
    (syntax-rules ()
      ((_ cmd-name param-num min max offset)
       (begin (: cmd-name (fixnum fixnum -> (u8vector any -> fixnum)))
              (define (cmd-name ch n)
                (cond ((< n min) (error (conc "below range [" min "," max "]")))
                      ((> n max) (error (conc "above range [" min "," max "]")))
                      (else
                        (nrpn (bitwise-and 15 ch) param-num (+ n offset)))))))))

